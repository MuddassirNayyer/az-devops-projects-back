# Copy this to .env.local for local dev
ADO_ORG_URL=https://dev.azure.com/your-org-name
ADO_PAT=your-personal-access-token-here

# MongoDB connection string. The database to back up is the one named in the
# URI path (e.g. .../ccf?retryWrites=true -> backs up "ccf").
# Use a read-only user — the backup never writes.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
